#!/usr/bin/env python3
"""Validate component configs against the repo schema."""

import argparse
import glob
import os
import re
import sys
from pathlib import Path

try:
    import yaml
except ModuleNotFoundError:  # pragma: no cover - exercised in minimal local envs
    yaml = None

REPO_ROOT = Path(__file__).resolve().parents[2]

REQUIRED_FIELDS = ["name", "description", "runtime", "model", "system_instructions"]
VALID_RUNTIMES = {"claude-code", "codex", "opencode"}
VALID_VISIBILITIES = {"private", "public"}
LEGACY_FIELDS = {
    "tool": "runtime",
    "env": "custom_env",
    "cli_args": "custom_args",
    "concurrency": "max_concurrent_tasks",
}
GITHUB_REF_PATTERN = re.compile(r"^github:[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$")
NAME_PATTERN = re.compile(r"^[a-z0-9][a-z0-9-]*[a-z0-9]$")
PROTOCOL_COPY_GLOB = "agents/*/skills/*/references/squad-communication-protocol.md"
PROTOCOL_CANONICAL = "squads/research-squad/protocol.md"
RESEARCH_SQUAD_CONFIG = "squads/research-squad/squad.yaml"
RESEARCH_POLICY_GLOBS = [
    "squads/research-squad/*.md",
    "agents/project-orchestrator-agent/**/*.md",
    "agents/project-planner-agent/**/*.md",
    "agents/research-agent/**/*.md",
    "agents/research-adversarial-agent/**/*.md",
    "agents/technical-writer-agent/**/*.md",
]
WORKER_POLICY_GLOBS = [
    "agents/project-planner-agent/instructions.md",
    "agents/research-agent/**/*.md",
    "agents/research-adversarial-agent/**/*.md",
    "agents/technical-writer-agent/**/*.md",
]
NON_TARGET_GUARD_FILES = [
    "agents/project-planner-agent/instructions.md",
    "agents/research-agent/instructions.md",
    "agents/research-adversarial-agent/instructions.md",
    "agents/technical-writer-agent/instructions.md",
]
FORBIDDEN_RESEARCH_POLICY_TERMS = [
    "event_seq",
    "parent_event",
    "daemon-style watchdog",
    "daemon watchdog",
]


class YamlParseError(Exception):
    pass


def _parse_scalar(value):
    value = value.strip()
    if value in {"", "null", "None", "~"}:
        return None
    if value == "{}":
        return {}
    if value == "[]":
        return []
    if value in {"true", "false"}:
        return value == "true"
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    if value.startswith("'") and value.endswith("'"):
        return value[1:-1]
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    return value


def _fallback_safe_load(text):
    """Parse the small YAML subset used by agent config files."""
    data = {}
    current_key = None
    current_list = None

    for lineno, raw_line in enumerate(text.splitlines(), start=1):
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue

        indent = len(raw_line) - len(raw_line.lstrip(" "))
        stripped = line.strip()

        if indent == 0:
            current_key = None
            current_list = None
            if ":" not in stripped:
                raise YamlParseError(f"line {lineno}: expected key: value")
            key, value = stripped.split(":", 1)
            key = key.strip()
            value = value.strip()
            if value == "":
                data[key] = []
                current_key = key
                current_list = data[key]
            else:
                data[key] = _parse_scalar(value)
            continue

        if current_list is not None and stripped.startswith("- "):
            item = stripped[2:].strip()
            if re.search(r":\s+", item):
                key, value = item.split(":", 1)
                current_list.append({key.strip(): _parse_scalar(value)})
            else:
                current_list.append(_parse_scalar(item))
            continue

        if current_list is not None and current_list and isinstance(current_list[-1], dict):
            if ":" not in stripped:
                raise YamlParseError(f"line {lineno}: expected nested key: value")
            key, value = stripped.split(":", 1)
            current_list[-1][key.strip()] = _parse_scalar(value)
            continue

        if current_key is not None:
            continue

        raise YamlParseError(f"line {lineno}: unsupported YAML structure")

    return data


def load_yaml(text):
    if yaml is not None:
        return yaml.safe_load(text)
    return _fallback_safe_load(text)


def rel(path):
    return str(path.relative_to(REPO_ROOT))


def path_exists(repo_path):
    return (REPO_ROOT / repo_path).exists()


def validate_agent(filepath):
    errors = []
    path = Path(filepath)
    expected_name = path.stem
    relpath = rel(path)
    expected_relpath = f"agents/{expected_name}/{expected_name}.yaml"

    try:
        with open(path) as f:
            data = load_yaml(f.read())
    except (YamlParseError, getattr(yaml, "YAMLError", YamlParseError)) as e:
        errors.append(f"YAML parse error: {e}")
        return expected_name, errors

    if not isinstance(data, dict):
        errors.append("YAML root is not a mapping")
        return expected_name, errors

    for field in REQUIRED_FIELDS:
        if field not in data or data[field] is None or str(data[field]).strip() == "":
            errors.append(f"Missing required field: {field}")

    for legacy, replacement in LEGACY_FIELDS.items():
        if legacy in data:
            errors.append(f"Legacy field found: {legacy}; use {replacement}")

    name = data.get("name")
    if name:
        if not isinstance(name, str) or not NAME_PATTERN.match(name):
            errors.append(f"Invalid name: {name}")
        if name != expected_name:
            errors.append(f"Name mismatch: field={name}, file={expected_name}")
        if relpath != expected_relpath:
            errors.append(f"Path mismatch: expected {expected_relpath}, got {relpath}")

    runtime = data.get("runtime")
    if runtime and runtime not in VALID_RUNTIMES:
        errors.append(f"Unknown runtime: {runtime}")

    visibility = data.get("visibility")
    if visibility is not None and visibility not in VALID_VISIBILITIES:
        errors.append(f"Invalid visibility: {visibility}")

    mct = data.get("max_concurrent_tasks")
    if mct is not None:
        if not isinstance(mct, int) or mct <= 0:
            errors.append("max_concurrent_tasks must be a positive integer")

    si = data.get("system_instructions")
    if si:
        if not os.path.isfile(REPO_ROOT / si):
            errors.append(f"File not found: {si}")
        expected_instructions = f"agents/{expected_name}/instructions.md"
        if si != expected_instructions:
            errors.append(f"system_instructions should be {expected_instructions}")

    for path_ref in data.get("knowledge", []):
        if not path_exists(path_ref):
            errors.append(f"Missing: {path_ref}")

    for ref in data.get("skills", []):
        if isinstance(ref, str) and ref.startswith("github:"):
            if not GITHUB_REF_PATTERN.match(ref):
                errors.append(f"Invalid format: {ref}")
        elif isinstance(ref, str):
            full = REPO_ROOT / ref
            if not full.exists():
                errors.append(f"Missing: {ref}")
            elif full.is_dir() and not (full / "SKILL.md").is_file():
                errors.append(f"Missing skill file: {ref}/SKILL.md")
        else:
            errors.append(f"Invalid skill entry: {ref}")

    return expected_name, errors


def validate_protocol_copies():
    errors = []
    canonical = REPO_ROOT / PROTOCOL_CANONICAL
    if not canonical.is_file():
        return [f"Missing canonical protocol: {PROTOCOL_CANONICAL}"]

    squad_config = REPO_ROOT / RESEARCH_SQUAD_CONFIG
    if not squad_config.is_file():
        errors.append(f"Missing squad config: {RESEARCH_SQUAD_CONFIG}")
    else:
        try:
            data = load_yaml(squad_config.read_text())
        except (YamlParseError, getattr(yaml, "YAMLError", YamlParseError)) as e:
            errors.append(f"Squad YAML parse error: {e}")
        else:
            if not isinstance(data, dict) or data.get("protocol") != PROTOCOL_CANONICAL:
                errors.append(f"squad.yaml protocol must be {PROTOCOL_CANONICAL}")

    canonical_text = canonical.read_text()
    copies = sorted(REPO_ROOT.glob(PROTOCOL_COPY_GLOB))
    if len(copies) != 6:
        errors.append(f"Expected 6 protocol copies under agent skills, found {len(copies)}")
    for copy_path in copies:
        if copy_path.read_text() != canonical_text:
            errors.append(f"Protocol copy differs from canonical: {rel(copy_path)}")
    return errors


def _rel_to_root(path, root):
    return str(path.relative_to(root))


def _markdown_sections(text):
    heading_re = re.compile(r"^(#{1,6})\s+(.+?)\s*$", re.MULTILINE)
    matches = list(heading_re.finditer(text))
    for index, match in enumerate(matches):
        level = len(match.group(1))
        title = match.group(2)
        start = match.end()
        end = len(text)
        for next_match in matches[index + 1 :]:
            end = next_match.start()
            break
        yield level, title, text[start:end]


def _policy_files(root, globs):
    files = []
    for pattern in globs:
        files.extend(root.glob(pattern))
    return sorted({path for path in files if path.is_file()})


def _directory_block_has_trigger_mention(lines, start_index):
    for line in lines[start_index + 1 : start_index + 12]:
        stripped = line.strip()
        if stripped == "```" or stripped.startswith("#"):
            break
        if stripped and not stripped.startswith("-"):
            break
        if "mention://agent/" in line:
            return True
    return False


def validate_research_squad_dispatch_policy(root=REPO_ROOT):
    """Validate research squad dispatch/handoff policy is single-target."""
    root = Path(root)
    errors = []
    files = _policy_files(root, RESEARCH_POLICY_GLOBS)
    worker_files = set(_policy_files(root, WORKER_POLICY_GLOBS))

    for path in files:
        text = path.read_text()
        relpath = _rel_to_root(path, root)

        if "agent roster" in text.lower():
            errors.append(f"{relpath}: use non-triggering Agent Directory, not agent roster")

        lines = text.splitlines()
        for index, line in enumerate(lines):
            if line.strip().startswith("**Agent Directory") and _directory_block_has_trigger_mention(lines, index):
                errors.append(f"{relpath}: Agent Directory must not contain mention://agent links")
                break

        for term in FORBIDDEN_RESEARCH_POLICY_TERMS:
            if term in text:
                errors.append(f"{relpath}: forbidden research dispatch term found: {term}")

        if path in worker_files:
            for lineno, line in enumerate(text.splitlines(), start=1):
                lowered = line.lower()
                if "multica agent list" not in lowered:
                    continue
                allowed = (
                    "orchestrator" in lowered
                    or "do not" in lowered
                    or "never" in lowered
                    or "not call" in lowered
                    or "does not" in lowered
                    or "without" in lowered
                    or "unavailable" in lowered
                )
                if not allowed:
                    errors.append(f"{relpath}:{lineno}: worker must not call multica agent list for handoff")
                    break

        for level, title, body in _markdown_sections(text):
            if level == 1:
                continue
            normalized_title = title.lower()
            if (
                "dispatch" in normalized_title
                and not any(
                    excluded in normalized_title
                    for excluded in ["dispatch flow", "dispatch parameters", "dispatch note", "dispatching"]
                )
                and body.count("mention://agent/") > 1
            ):
                errors.append(f"{relpath}: dispatch section '{title}' has multiple trigger mentions")

            if (
                "**Target agent**" in body
                and "**Next action**" in body
                and body.count("mention://agent/") > 1
            ):
                errors.append(f"{relpath}: handoff template section '{title}' has multiple trigger mentions")

    canonical = root / PROTOCOL_CANONICAL
    if canonical.is_file():
        protocol = canonical.read_text()
        required = {
            "Agent Directory": "non-triggering Agent Directory",
            "created_at": "created_at timeline sorting",
            "phase": "phase timeline marker",
            "round": "round timeline marker",
            "multica issue runs": "run history sorting note",
            "Continuous-Action": "Orchestrator continuous-action rule",
            "pending actions": "pending actions fallback",
            "do not post a Multica issue comment": "silent non-target guard",
            "cancel/no-op": "non-target runtime fallback",
        }
        for needle, description in required.items():
            if needle not in protocol:
                errors.append(f"{PROTOCOL_CANONICAL}: missing {description}")

    for relpath in NON_TARGET_GUARD_FILES:
        guard_file = root / relpath
        if not guard_file.is_file():
            continue
        text = guard_file.read_text()
        missing = [
            phrase
            for phrase in ["do not post a Multica issue comment", "cancel/no-op"]
            if phrase not in text
        ]
        if missing:
            errors.append(f"{relpath}: missing silent non-target guard")

    return errors


def discover_agent_files():
    return sorted(glob.glob(str(REPO_ROOT / "agents" / "*" / "*.yaml")))


def main():
    parser = argparse.ArgumentParser(description="Validate component configs")
    parser.add_argument("--agent", help="Validate a single agent by name")
    parser.add_argument("--skip-protocol", action="store_true", help="Skip protocol copy consistency check")
    parser.add_argument(
        "files", nargs="*", help="Explicit file paths (overrides --agent and default glob)"
    )
    args = parser.parse_args()

    if args.files:
        files = [str((REPO_ROOT / path).resolve()) if not os.path.isabs(path) else path for path in args.files]
    elif args.agent:
        path = REPO_ROOT / "agents" / args.agent / f"{args.agent}.yaml"
        if not path.is_file():
            print(f"Agent config not found: {path}")
            sys.exit(1)
        files = [str(path)]
    else:
        files = discover_agent_files()

    if not files:
        print("No agent configs found.")
        sys.exit(1)

    all_passed = True
    results = []

    for filepath in files:
        agent_name, errors = validate_agent(filepath)
        passed = len(errors) == 0
        if not passed:
            all_passed = False
        results.append((agent_name, len(REQUIRED_FIELDS) + 7, passed, errors))

    if not args.skip_protocol:
        protocol_errors = validate_protocol_copies()
        if protocol_errors:
            all_passed = False
        results.append(("protocol-copies", 3, not protocol_errors, protocol_errors))

        policy_errors = validate_research_squad_dispatch_policy()
        if policy_errors:
            all_passed = False
        results.append(("research-dispatch-policy", 9, not policy_errors, policy_errors))

    name_width = max(len(r[0]) for r in results)
    print(f"{'Component':<{name_width}}  {'Checks':>6}  Result")
    print(f"{'-' * name_width}  {'-' * 6}  ------")
    for component, checks, passed, errors in results:
        status = "PASS" if passed else "FAIL"
        print(f"{component:<{name_width}}  {checks:>6}  {status}")
        for err in errors:
            print(f"  - {err}")

    sys.exit(0 if all_passed else 1)


if __name__ == "__main__":
    main()
